# Copia este archivo como .streamlit/secrets.toml (local) o pégalo en
# Streamlit Cloud -> tu app -> Settings -> Secrets.
# El .toml real está en .gitignore: nunca se sube al repo.

[general]
# Contraseña de acceso para los usuarios de la app (obligatoria si la publicas).
# Puede ser texto plano o un hash: app_password = "sha256:..." (para generarlo:
#   python -c "import hashlib;print(hashlib.sha256('TU_CLAVE'.encode()).hexdigest())")
app_password = "cambia-esta-clave"

# Modelo que etiqueta. Recomendado: gpt-4.1-mini (el nano se queda corto en tono).
llm_api_key = "sk-tu-key-de-openai"
proveedor = "OpenAI"
modelo = "gpt-4.1-mini"
base_url = "https://api.openai.com/v1"
# Gobernación/alcaldía -> "Aspectual estricto (recomendado)"
# Gremio, federación, cámara o empresa -> "Favorabilidad del sector (para gremios)"
criterio = "Favorabilidad del sector (para gremios)"
